# =============================================================================
# frontend/.env.example  —  Copy to .env.local and fill in values
# =============================================================================

# API base URL (leave empty to use the Vite proxy in development)
# In production (Docker), nginx proxies /api/v1 to the backend — leave empty.
VITE_API_URL=

# Optional: override the API prefix if deploying to a custom subdomain
# VITE_API_URL=https://api.yourdomain.com