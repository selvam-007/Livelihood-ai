# =============================================================================
# backend/.env.example  —  Copy to .env and fill in values before running
# =============================================================================
# NEVER commit .env to version control.

# ── Security ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_64_CHAR_HEX_STRING

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440   # 24 hours

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=production             # development | staging | production
DEBUG=false

# ── Database ─────────────────────────────────────────────────────────────────
# For local dev (SQLite — no further config needed):
#   DATABASE_URL=sqlite:///./livelihood_ai.db
# For production (PostgreSQL):
DATABASE_URL=postgresql://livelihood:REPLACE_PASSWORD@localhost:5432/livelihood_ai

# ── Redis (rate limiting) ─────────────────────────────────────────────────────
# Leave blank to use in-memory rate limiting (not recommended for production)
REDIS_URL=redis://localhost:6379/0

# Number of trusted reverse proxy hops in front of this app (0 = none)
# Set to 1 if behind a single nginx/load-balancer
TRUSTED_PROXY_COUNT=0

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── External AI / STT ────────────────────────────────────────────────────────
# Gemini AI for NLP features
GEMINI_API_KEY=REPLACE_WITH_GOOGLE_AI_STUDIO_KEY

# Speech-to-Text provider: disabled | whisper | bhashini
STT_PROVIDER=disabled

# Whisper (if STT_PROVIDER=whisper)
# WHISPER_MODEL_SIZE=base
# WHISPER_DEVICE=cpu

# Bhashini (if STT_PROVIDER=bhashini)
# BHASHINI_USER_ID=REPLACE
# BHASHINI_API_KEY=REPLACE
# BHASHINI_PIPELINE_ID=REPLACE

# ── Notification providers (optional) ────────────────────────────────────────
# WhatsApp Business API
# WHATSAPP_API_TOKEN=REPLACE
# WHATSAPP_PHONE_NUMBER_ID=REPLACE

# SMS (Twilio / fast2sms / etc.)
# SMS_API_KEY=REPLACE
# SMS_SENDER_ID=REPLACE

# ── PostgreSQL (docker-compose only) ─────────────────────────────────────────
POSTGRES_USER=livelihood
POSTGRES_PASSWORD=REPLACE_STRONG_PASSWORD
POSTGRES_DB=livelihood_ai